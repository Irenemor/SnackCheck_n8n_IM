    {
      "parameters": {
        "jsCode": "const sugar = Number($json.sugars_100g);\nconst salt = Number($json.salt_100g);\nconst fat = Number($json.fat_100g);\n\nconst sugar_level =\n  sugar < 5 ? 'low' :\n  sugar <= 22.5 ? 'medium' : 'high';\n\nconst salt_level =\n  salt < 0.3 ? 'low' :\n  salt <= 1.5 ? 'medium' : 'high';\n\nconst fat_level =\n  fat < 3 ? 'low' :\n  fat <= 17.5 ? 'medium' : 'high';\n\nconst preocup_score =\n  [sugar_level, salt_level, fat_level]\n    .filter(level => level === 'high').length;\n\nconst semaforo_verdict =\n  preocup_score === 0 ? 'healthy' :\n  preocup_score === 1 ? 'moderate' : 'unhealthy';\n\nreturn {\n  json: {\n    ...$json,\n    sugar_level,\n    salt_level,\n    fat_level,\n    preocup_score,\n    semaforo_verdict\n  }\n};"
      },
