              "value": "={{ \n  (() => {\n\n    // 1. Si Nutri-Score es desconocido, manda el semáforo\n\n    if (nutriScoreVal === 'unknown' || !nutriScoreVal) {\n      return $json.semaforo_verdict;\n    }\n\n    // 2. Si cualquiera de los dos es no saludable\n    if (semaforo.includes('unhealthy') || nutri.includes('unhealthy')) {\n      return 'unhealthy : 🔴';\n    }\n\n    // 3. Si cualquiera de los dos es moderado\n    if (semaforo.includes('moderate') || nutri.includes('moderate')) {\n      return 'moderate : 🟡';\n    }\n\n    // 4. Ambos coinciden en saludable\n    return 'healthy : 🟢';\n  })()\n}}",
